# =====================================================================
# ResumeIQ Backend Docker Build Ignore File
# =====================================================================

.git
.gitignore
.dockerignore
Dockerfile

# Secrets and Environment Files
.env
.env.*
.env.local
*.pem
*.key
*.crt
*.json
!requirements*.txt

# Python Caches & Virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
requirements-dev.txt

# Logs, Archives & Temp Files
*.log
*.zip
scratch/
