# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
# Allowed CORS origins (comma-separated or JSON array)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Firebase Configuration
FIREBASE_PROJECT_ID=resumeiq-3cfe6
# Optional service account path (if not using Application Default Credentials):
# FIREBASE_CREDENTIALS_PATH=./service-account.json

# AI Analyzer Engine Configuration (Server-Side Only)
AI_ANALYZER_PROVIDER=groq
AI_ANALYZER_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_server_side_groq_api_key_here

# Optional Alternative Provider (Gemini)
# AI_ANALYZER_PROVIDER=gemini
# AI_ANALYZER_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_server_side_gemini_api_key_here

# Optional Alternative Provider (NVIDIA)
# AI_ANALYZER_PROVIDER=nvidia
# NVIDIA_API_KEY=your_server_side_nvidia_api_key_here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# AI Provider Fallback Chain (Ordered failover sequence)
AI_PROVIDER_CHAIN=groq,gemini,nvidia

# Optional Cloud Storage (Cloudinary raw backup storage)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
