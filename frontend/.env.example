# =====================================================================
# ResumeIQ Frontend Environment Configuration Template
# =====================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel / Node.js runtime), configure these in your host dashboard.
# NEVER commit .env or .env.local with real credentials to source control.

# ---------------------------------------------------------------------
# 1. Firebase Web Client Configuration (Required)
# Public project identifiers from Firebase Console -> Project Settings -> General
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------
# 2. Backend API Configuration (Required)
# URL of the FastAPI backend service
# ---------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
# Optional server-side alias used by Next.js proxy route handlers:
# BACKEND_API_URL=http://localhost:8000

# ---------------------------------------------------------------------
# 3. Test & E2E Configuration (TEST-ONLY - DO NOT ENABLE IN PRODUCTION)
# ---------------------------------------------------------------------
# NEXT_PUBLIC_E2E_TEST_MODE=false
# PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3001
