# =====================================================================
# ResumeIQ Docker Compose Local Development Override Example
# =====================================================================
# Copy this file to docker-compose.override.yml to customize your local
# containerized development environment without committing secrets.
#
# Usage:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build
# =====================================================================

services:
  backend:
    environment:
      - ENVIRONMENT=development
      - LOG_LEVEL=DEBUG
      - GROQ_API_KEY=your_local_groq_api_key_here
      # - GEMINI_API_KEY=your_local_gemini_api_key_here
      # - NVIDIA_API_KEY=your_local_nvidia_api_key_here
      - CORS_ORIGINS=http://localhost:3000

  frontend:
    environment:
      - NEXT_PUBLIC_FIREBASE_API_KEY=your_local_firebase_web_api_key
      - NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
      - NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
